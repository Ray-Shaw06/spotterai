{
  "name": "spotterai",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Your AI fitness copilot \u2014 plan, track, adapt, and audit your training. Generates a weekly plan with Gemini, then a deterministic evaluator flags risky/low-quality programming (flags-first, with fixes) before you trust it.",
  "scripts": {
    "dev": "vercel dev",
    "start": "vercel dev",
    "test": "node --test",
    "test:coverage": "mkdir -p coverage && node --test --experimental-test-coverage --test-coverage-exclude='test/**' --test-coverage-exclude='scripts/**' --test-reporter=lcov --test-reporter-destination=coverage/lcov.info --test-reporter=spec --test-reporter-destination=stdout",
    "test:firebase-emulator": "node scripts/run-firebase-emulator-gate.mjs",
    "check": "node --test",
    "eval": "node eval.mjs",
    "eval:nutrition": "node eval-nutrition.mjs",
    "benchmark:history": "node scripts/append-benchmark-history.mjs",
    "draft-metadata": "node --env-file=.env scripts/draft-exercise-metadata.mjs",
    "fonts": "node scripts/fetch-fonts.mjs",
    "fonts:check": "node scripts/fetch-fonts.mjs --check"
  },
  "license": "MIT",
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "firebase-admin": "^14.2.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "firebase": "^12.16.0",
    "firebase-tools": "^15.23.0"
  }
}
