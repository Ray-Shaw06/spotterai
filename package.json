{
  "name": "spotterai",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Your AI fitness copilot — plan, track, adapt, and audit your training. Generates a weekly plan with Gemini, then a deterministic evaluator flags risky/low-quality programming (flags-first, with fixes) before you trust it.",
  "scripts": {
    "dev": "vercel dev",
    "start": "vercel dev",
    "test": "node --test",
    "test:firebase-emulator": "node scripts/run-firebase-emulator-gate.mjs",
    "check": "node --test",
    "eval": "node eval.mjs",
    "eval:nutrition": "node eval-nutrition.mjs"
  },
  "license": "MIT",
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "firebase": "^12.16.0",
    "firebase-tools": "^15.23.0"
  }
}
