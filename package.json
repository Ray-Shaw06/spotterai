{
  "name": "spotterai",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Your AI fitness copilot — plan, track, adapt, and audit your training. Generates a weekly plan with Gemini, then a deterministic evaluator flags risky/low-quality programming (flags-first, with fixes) before you trust it.",
  "scripts": {
    "dev": "vercel dev",
    "start": "vercel dev",
    "test": "node --test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check:readme": "node scripts/check-readme-claims.mjs",
    "verify": "npm run lint && npm run test && npm run eval && npm run check:readme",
    "test:coverage": "mkdir -p coverage && node --test --experimental-test-coverage --test-coverage-exclude='test/**' --test-coverage-exclude='scripts/**' --test-reporter=lcov --test-reporter-destination=coverage/lcov.info --test-reporter=spec --test-reporter-destination=stdout",
    "test:firebase-emulator": "node scripts/run-firebase-emulator-gate.mjs",
    "check": "node --test",
    "eval": "node eval.mjs",
    "eval:nutrition": "node eval-nutrition.mjs",
    "benchmark:history": "node scripts/append-benchmark-history.mjs",
    "draft-metadata": "node --env-file=.env scripts/draft-exercise-metadata.mjs",
    "fonts": "node scripts/fetch-fonts.mjs",
    "fonts:check": "node scripts/fetch-fonts.mjs --check",
    "visual:baseline": "node scripts/visual-snapshot.mjs baseline",
    "visual:check": "node scripts/visual-snapshot.mjs check"
  },
  "license": "MIT",
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "firebase-admin": "^14.2.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@firebase/rules-unit-testing": "^5.0.1",
    "eslint": "^9.39.4",
    "firebase": "^12.16.0",
    "firebase-tools": "^15.23.0",
    "globals": "^17.12.0",
    "playwright": "^1.63.0"
  }
}
