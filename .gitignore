# Secrets — never commit real keys
.env
.env.local
.env.*.local

# Dependencies
node_modules/

# Vercel
.vercel/

# Local isolated development workspaces
.worktrees/
.superpowers/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
firebase-debug.log*
firestore-debug.log*

# Generated asset pipelines (not part of the app)
output/

# Coverage report (regenerated by npm run test:coverage)
coverage/

# Visual-regression fingerprints (scripts/visual-snapshot.mjs). Machine-specific:
# computed values include resolved layout, which depends on font rasterisation.
.visual/

# OS / editor cruft
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
.gstack/

# Local-only brain context. Currently protected by .git/info/exclude, which is
# machine-local and not versioned; keep it here too so a fresh clone is safe.
CLAUDE.local.md

# Machine-drafted metadata awaiting review (scripts/draft-exercise-metadata.mjs).
# Reviewed entries are hand-moved into exercise-metadata.js; the raw draft is scratch.
scripts/out/
