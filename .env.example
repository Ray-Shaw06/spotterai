# SpotterAI environment variables
# ---------------------------------
# Copy this file to ".env" (which is git-ignored) and paste in your own key.
#
# Get a FREE Gemini API key — no credit card required — at:
#   https://aistudio.google.com/app/apikey
#
# The key is read ONLY by the serverless functions and is never exposed to the
# browser.

GEMINI_API_KEY=your_gemini_api_key_here

# OPTIONAL — Groq is a free, separate-capacity fallback for TEXT features (plan,
# coach, food/quick-log estimates). When Gemini is rate-limited or down, requests
# fall back to Groq so the AI keeps working. Leave blank to run Gemini-only.
# Free key (no card): https://console.groq.com/keys
# GROQ_API_KEY=your_groq_api_key_here
# GROQ_MODEL=llama-3.3-70b-versatile   # override the default model if needed

# OPTIONAL — Vercel server-only notification subscription configuration. Registration
# stays disabled until every required value is configured in the hosting
# provider and a fixed-window per-IP WAF rule covers POST, PATCH, and DELETE on
# /api/notifications.
# Preview must separately prove 429 responses for excess POST registration, authenticated PATCH, and authenticated DELETE before NOTIFICATION_REGISTRATION_ENABLED=true.
NOTIFICATION_REGISTRATION_ENABLED=false
FIREBASE_SERVICE_ACCOUNT_JSON=
NOTIFICATION_TOKEN_SECRET=
NOTIFICATION_DEDUP_SECRET=
NOTIFICATION_ALLOWED_ORIGIN=
NOTIFICATION_REGISTRATION_DAILY_CAP=
NOTIFICATION_WAF_RATE_LIMIT_RULE_ID=
WEB_PUSH_PUBLIC_KEY=

# Firebase dispatcher secrets are set interactively with
# `firebase functions:secrets:set`, not copied into Vercel. Empty names remain
# here only as an operator checklist; use functions/.secret.local for emulator
# overrides and never commit real values.
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=
