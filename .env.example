# SpotterAI environment variables
# ---------------------------------
# Copy this file to ".env" (which is git-ignored) and paste in your own key.
#
# Get a FREE Gemini API key — no credit card required — at:
#   https://aistudio.google.com/app/apikey
#
# The key is read ONLY by the serverless functions and is never exposed to the
# browser.

GEMINI_API_KEY=your_gemini_api_key_here

# OPTIONAL — Groq is a free, separate-capacity fallback for TEXT features (plan,
# coach, food/quick-log estimates). When Gemini is rate-limited or down, requests
# fall back to Groq so the AI keeps working. Leave blank to run Gemini-only.
# Free key (no card): https://console.groq.com/keys
# GROQ_API_KEY=your_groq_api_key_here
# GROQ_MODEL=llama-3.3-70b-versatile   # override the default model if needed

# OPTIONAL — server-only notification subscription configuration. These are
# non-secret placeholders; replace them only in the hosting provider's encrypted
# environment settings. Never expose the Admin JSON, token secret, or private
# VAPID key to browser code.
FIREBASE_SERVICE_ACCOUNT_JSON={"project_id":"your-firebase-project-id","client_email":"firebase-adminsdk@example-project.iam.gserviceaccount.com","private_key":"replace-with-your-private-key"}
NOTIFICATION_TOKEN_SECRET=replace-with-at-least-32-random-characters
WEB_PUSH_PUBLIC_KEY=replace-with-your-vapid-public-key
WEB_PUSH_PRIVATE_KEY=replace-with-your-vapid-private-key
WEB_PUSH_SUBJECT=mailto:owner@example.com
