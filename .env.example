# SpotterAI environment variables
# ---------------------------------
# Copy this file to ".env" (which is git-ignored) and paste in your own key.
#
# Get a FREE Gemini API key — no credit card required — at:
#   https://aistudio.google.com/app/apikey
#
# The key is read ONLY by the serverless functions and is never exposed to the
# browser.

GEMINI_API_KEY=your_gemini_api_key_here

# OPTIONAL — Groq is a free, separate-capacity fallback for TEXT features (plan,
# coach, food/quick-log estimates). When Gemini is rate-limited or down, requests
# fall back to Groq so the AI keeps working. Leave blank to run Gemini-only.
# Free key (no card): https://console.groq.com/keys
# GROQ_API_KEY=your_groq_api_key_here
# GROQ_MODEL=llama-3.3-70b-versatile   # override the default model if needed
#
# Reminders (calendar export + local rest-timer alerts) are fully on-device and
# need NO environment variables — there is no notification backend.
